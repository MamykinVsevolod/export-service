# Настройки приложения
APP_NAME=ExportService
APP_VERSION=1.0.0
DEBUG=True

# Настройки сервера
HOST=0.0.0.0
PORT=8000

# База данных PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=export_user
DB_PASSWORD=export_password
DB_NAME=export_db

# Настройки экспорта
MAX_EXPORT_SIZE=10000
EXPORT_TIMEOUT=300